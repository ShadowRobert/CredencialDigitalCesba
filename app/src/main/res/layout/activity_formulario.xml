<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/violeta_claro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos del estudiante"
            android:textColor="@color/violeta_oscuro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nombre completo"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/etMatricula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Matrícula"
            android:inputType="textCapCharacters" />

        <Spinner
            android:id="@+id/spCarrera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/carreras" />

        <Spinner
            android:id="@+id/spSemestre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/semestres" />

        <EditText
            android:id="@+id/etGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grupo (ej. A)"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress" />

        <Spinner
            android:id="@+id/spTipo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/tipos_usuario" />

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="150dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="#CCCCCC"
            android:scaleType="centerCrop"
            android:contentDescription="Foto del estudiante" />

        <Button
            android:id="@+id/btnFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/violeta"
            android:text="Tomar foto"
            android:fitsSystemWindows="true"
            android:textColor="@color/negro" />

        <Button
            android:id="@+id/btnGenerar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/violeta_oscuro"
            android:text="Generar credencial"
            android:textColor="@color/negro" />
    </LinearLayout>
</ScrollView>